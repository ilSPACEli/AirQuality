
@baseUrl = http://localhost:3000/api/v1

### Стан сервісу
GET {{baseUrl}}/health

### ---------- СТАНЦІЇ ----------

### Створити станцію → 201 + Location
# @name createStation

POST {{baseUrl}}/stations
Content-Type: application/json

{
  "code": "TEST-01",
  "name": "Тестова станція",
  "city": "Kyiv",
  "latitude": 50.4501,
  "longitude": 30.5234,
  "measurement_types": ["pm25", "pm10", "temperature"]
}

### Повторне створення → 409 Conflict
POST {{baseUrl}}/stations
Content-Type: application/json

{
  "code": "TEST-01",
  "name": "Тестова станція",
  "city": "Kyiv",
  "latitude": 50.4501,
  "longitude": 30.5234
}

### Невалідні дані → 422 з details
POST {{baseUrl}}/stations
Content-Type: application/json

{
  "code": "TEST-02",
  "name": "",
  "city": "Kyiv",
  "latitude": 10,
  "longitude": 30.5
}

### Зламаний JSON → 400
POST {{baseUrl}}/stations
Content-Type: application/json

{ "code": "TEST-03",

### Усі станції (пагінація)
GET {{baseUrl}}/stations?page=1&limit=10

### Станції міста
GET {{baseUrl}}/stations?city=Kyiv&active=true

### Одна станція → 200
GET {{baseUrl}}/stations/TEST-01

### Неіснуюча станція → 404
GET {{baseUrl}}/stations/NOPE-99

### Повна заміна (PUT)
PUT {{baseUrl}}/stations/TEST-01
Content-Type: application/json

{
  "name": "Тестова станція (оновлена)",
  "city": "Kyiv",
  "latitude": 50.46,
  "longitude": 30.52,
  "measurement_types": ["pm25"]
}

### Часткове оновлення (PATCH)
PATCH {{baseUrl}}/stations/TEST-01
Content-Type: application/json

{
  "active": false
}

### ---------- ВИМІРЮВАННЯ ----------

### Створити вимірювання → 201 + Location
# @name createMeasurement
POST {{baseUrl}}/measurements
Content-Type: application/json

{
  "station_id": "TEST-01",
  "measured_at": "2026-03-14T08:00:00.000Z",
  "pm25": 23.4,
  "pm10": 31.2,
  "temperature": 8.5
}

###
@measurementId = {{createMeasurement.response.body.data.id}}

### Те саме вимірювання ще раз → 409
POST {{baseUrl}}/measurements
Content-Type: application/json

{
  "station_id": "TEST-01",
  "measured_at": "2026-03-14T08:00:00.000Z",
  "pm25": 23.4
}

### Від'ємна концентрація → 422
POST {{baseUrl}}/measurements
Content-Type: application/json

{
  "station_id": "TEST-01",
  "measured_at": "2026-03-14T09:00:00.000Z",
  "pm25": -5
}

### Вкладений ресурс: додати вимірювання до станції
POST {{baseUrl}}/stations/TEST-01/measurements
Content-Type: application/json

{
  "measured_at": "2026-03-14T10:00:00.000Z",
  "pm25": 41.7,
  "pm10": null
}

### Вкладений ресурс: вимірювання станції
GET {{baseUrl}}/stations/TEST-01/measurements

### Статистика станції
GET {{baseUrl}}/stations/TEST-01/statistics

### Фільтри + сортування + пагінація
GET {{baseUrl}}/measurements?city=Kyiv&pollutant=pm25&from=2026-03-01&to=2026-12-31&sort=-pm25&page=1&limit=5

### Порожня колекція → 200 і []
GET {{baseUrl}}/measurements?station=TEST-01&from=2030-01-01

### Перша сторінка (у meta є next_cursor)
# @name firstPage
GET {{baseUrl}}/measurements?limit=3

### Наступна сторінка за курсором
GET {{baseUrl}}/measurements?limit=3&after={{firstPage.response.body.meta.next_cursor}}

### Поле сортування поза whitelist → 422
GET {{baseUrl}}/measurements?sort=__v

### Одне вимірювання
GET {{baseUrl}}/measurements/{{measurementId}}

### Повна заміна вимірювання (PUT)
PUT {{baseUrl}}/measurements/{{measurementId}}
Content-Type: application/json

{
  "station_id": "TEST-01",
  "measured_at": "2026-03-14T08:00:00.000Z",
  "pm25": 19.9
}

### Видалити вимірювання → 204
DELETE {{baseUrl}}/measurements/{{measurementId}}

### Повторне видалення → теж 204
DELETE {{baseUrl}}/measurements/{{measurementId}}

### ---------- ПРИБИРАННЯ ----------

### Видалити станцію разом з вимірюваннями → 204
DELETE {{baseUrl}}/stations/TEST-01

### Неіснуючий маршрут → 404
GET {{baseUrl}}/unknown
