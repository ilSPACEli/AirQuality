# Скопіюйте цей файл у .env і підставте власні значення
PORT=3000
NODE_ENV=development

# Рядок підключення MongoDB Atlas (або mongodb://localhost:27017/eco_monitoring)
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/eco_monitoring

# Дозволені походження для CORS, через кому
CORS_ORIGINS=http://localhost:5173

SAVEECOBOT_API=https://api.saveecobot.com/output.json
