{
  "name": "eco-monitoring-api",
  "version": "1.0.0",
  "description": "REST API for environmental monitoring data (Express + MongoDB)",
  "private": true,
  "type": "module",
  "main": "src/server.js",
  "engines": {
    "node": ">=20.11"
  },
  "scripts": {
    "start": "node src/server.js",
    "dev": "nodemon src/server.js",
    "test": "cross-env NODE_OPTIONS=--experimental-vm-modules jest --runInBand",
    "seed": "node scripts/seed.js",
    "import": "node scripts/import-saveecobot.js"
  },
  "jest": {
    "testEnvironment": "node",
    "testTimeout": 60000,
    "transform": {}
  },
  "dependencies": {
    "cors": "^2.8.6",
    "dotenv": "^18.0.7",
    "express": "^5.3.0",
    "express-validator": "^7.3.2",
    "helmet": "^8.3.0",
    "mongoose": "^9.11.1",
    "morgan": "^1.12.1",
    "swagger-jsdoc": "^6.3.0",
    "swagger-ui-express": "^5.0.1"
  },
  "devDependencies": {
    "cross-env": "^10.1.0",
    "jest": "^30.5.2",
    "mongodb-memory-server": "^11.3.0",
    "nodemon": "^3.1.14",
    "supertest": "^7.3.1"
  }
}
